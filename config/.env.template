# Open WebUI Environment Configuration Template
# Copy to ~/open-webui-data/.env and fill in your values
# DO NOT commit the real .env — it contains secrets

# ── Core ──────────────────────────────────────────────────────────────────────
WEBUI_NAME="Image Studio"
DATA_DIR=/data/data/com.termux/files/home/open-webui-data
FRONTEND_BUILD_DIR=/data/data/com.termux/files/home/open-webui-env/lib/python3.11/site-packages/open_webui/frontend

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# DO NOT change after first run — it encrypts stored credentials
WEBUI_SECRET_KEY=GENERATE_AND_PASTE_HERE

# ── Network ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080

# ── Lightweight Slim Mode (Remote OpenRouter Only) ────────────────────────────
USE_SLIM_DOCKER=true
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=false

# ── Disable heavy optional features ───────────────────────────────────────────
ENABLE_RAG_WEB_SEARCH=false
ENABLE_SEARCH_QUERY=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_MESSAGE_RATING=false
ENABLE_LOGIN_FORM=true
ENABLE_SIGNUP=true

# ── Logging ───────────────────────────────────────────────────────────────────
GLOBAL_LOG_LEVEL=INFO
